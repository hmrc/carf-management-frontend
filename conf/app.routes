# microservice specific routes

->         /manage-your-rcasps/hmrc-frontend                     hmrcfrontend.Routes

GET        /manage-your-rcasps/assets/*file                      controllers.Assets.versioned(path="/public", file: Asset)

GET        /manage-your-rcasps/refresh-session                   controllers.KeepAliveController.keepAlive()

GET        /manage-your-rcasps/there-is-a-problem                controllers.JourneyRecoveryController.onPageLoad(continueUrl: Option[RedirectUrl] ?= None)

GET        /manage-your-rcasps/placeholder                       controllers.PlaceholderController.onPageLoad(message: String)

GET        /manage-your-rcasps/check-your-answers                controllers.CheckYourAnswersController.onPageLoad()

GET        /manage-your-rcasps/account/sign-out-survey           controllers.auth.AuthController.signOut()
GET        /manage-your-rcasps/account/sign-out                  controllers.auth.AuthController.signOutNoSurvey()
GET        /manage-your-rcasps/account/signed-out                controllers.auth.SignedOutController.onPageLoad()

GET        /manage-your-rcasps/unauthorised                      controllers.UnauthorisedController.onPageLoad()

GET        /manage-cryptoasset-reports                           controllers.HomePageController.onPageLoad()

GET        /manage-your-rcasps/organisation-name                        controllers.organisation.OrganisationNameController.onPageLoad(mode: Mode = NormalMode)
POST       /manage-your-rcasps/organisation-name                        controllers.organisation.OrganisationNameController.onSubmit(mode: Mode = NormalMode)
GET        /manage-your-rcasps/change-organisation-name                  controllers.organisation.OrganisationNameController.onPageLoad(mode: Mode = ChangeMode)
POST       /manage-your-rcasps/change-organisation-name                  controllers.organisation.OrganisationNameController.onSubmit(mode: Mode = ChangeMode)

